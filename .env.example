# VisionForensics-X Environment Configuration
# Add your API keys below. The engine automatically reloads .env on every request.

# Primary VLM Provider (Groq Free Vision Models)
GROQ_API_KEY=

# Secondary Free VLM Provider (OpenRouter Free Vision Models)
OPENROUTER_API_KEY=

# Fallback VLM Provider (OpenAI GPT-4o-mini Vision)
OPENAI_API_KEY=

# Optional model overrides
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENAI_VISION_MODEL=gpt-4o-mini
